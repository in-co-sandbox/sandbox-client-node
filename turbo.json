{
    "$schema": "https://turborepo.dev/schema.json",
    "globalDependencies": ["tooling/typescript/*.json", "oxlint.config.ts", "oxfmt.config.ts"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "!node_modules/**",
                "!generated/**",
                "!.codegen/**",
                "!.turbo/**",
                "!dist/**",
                "!.build/**",
                "!.docker/**",
                "!.cache/**",
                "!coverage/**",
                "!tests/**",
                "!.agents/**",
                "!.claude/**",
                "!cicd/**",
                "!**/*.md",
                "!sonar-project.properties",
                "!*.zip",
                "!lambda_archive.version"
            ],
            "outputs": ["dist/**", ".build/**", "generated/**", ".codegen/**"]
        },
        "typecheck": {
            "dependsOn": ["build"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "!node_modules/**",
                "!generated/**",
                "!.codegen/**",
                "!.turbo/**",
                "!dist/**",
                "!.build/**",
                "!.docker/**",
                "!.cache/**",
                "!coverage/**",
                "!.agents/**",
                "!.claude/**",
                "!cicd/**",
                "!**/*.md",
                "!sonar-project.properties",
                "!*.zip",
                "!lambda_archive.version"
            ]
        },
        "lint": {
            "dependsOn": ["build"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "!node_modules/**",
                "!generated/**",
                "!.codegen/**",
                "!.turbo/**",
                "!dist/**",
                "!.build/**",
                "!.docker/**",
                "!.cache/**",
                "!coverage/**",
                "!.agents/**",
                "!.claude/**",
                "!cicd/**",
                "!**/*.md",
                "!sonar-project.properties",
                "!*.zip",
                "!lambda_archive.version"
            ]
        },
        "test": {
            "dependsOn": ["build"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "!node_modules/**",
                "!generated/**",
                "!.codegen/**",
                "!.turbo/**",
                "!dist/**",
                "!.build/**",
                "!.docker/**",
                "!.cache/**",
                "!coverage/**",
                "!.agents/**",
                "!.claude/**",
                "!cicd/**",
                "!**/*.md",
                "!sonar-project.properties",
                "!*.zip",
                "!lambda_archive.version"
            ],
            "cache": false
        }
    }
}

{
    "name": "@in-co-sandbox/kyc-api-client",
    "version": "1.0.0",
    "description": "KYC SDK for the Sandbox API",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "engines": {
        "node": ">=22.0.0"
    },
    "homepage": "https://sandbox.co.in",
    "files": [
        "dist/**/*"
    ],
    "scripts": {
        "clean": "sandbox-clean",
        "build": "sandbox-rollup lib",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "test:integration": "vitest run",
        "generate": "openapi-to-client ./resources/json/in-co-sandbox-kyc.openapi.json -o generated --generate-tests"
    },
    "exports": {
        "./aadhaar": {
            "types": "./dist/src/kyc/aadhaar/index.d.ts",
            "import": "./dist/src/kyc/aadhaar/index.js"
        },
        "./bank": {
            "types": "./dist/src/kyc/bank/index.d.ts",
            "import": "./dist/src/kyc/bank/index.js"
        },
        "./digilocker": {
            "types": "./dist/src/kyc/digilocker/index.d.ts",
            "import": "./dist/src/kyc/digilocker/index.js"
        },
        "./digilocker-sdk": {
            "types": "./dist/src/kyc/digilocker-sdk/index.d.ts",
            "import": "./dist/src/kyc/digilocker-sdk/index.js"
        },
        "./entitylocker": {
            "types": "./dist/src/kyc/entitylocker/index.d.ts",
            "import": "./dist/src/kyc/entitylocker/index.js"
        },
        "./entitylocker-sdk": {
            "types": "./dist/src/kyc/entitylocker-sdk/index.d.ts",
            "import": "./dist/src/kyc/entitylocker-sdk/index.js"
        },
        "./mca": {
            "types": "./dist/src/kyc/mca/index.d.ts",
            "import": "./dist/src/kyc/mca/index.js"
        },
        "./pan": {
            "types": "./dist/src/kyc/pan/index.d.ts",
            "import": "./dist/src/kyc/pan/index.js"
        }
    },
    "license": "ISC",
    "dependencies": {
        "@in-co-sandbox/api-client-core": "1.0.0",
        "@in-co-sandbox/api-endpoints": "1.0.0",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@in-co-sandbox/api-client-generator": "workspace:*",
        "@in-co-sandbox/vitest-config": "workspace:*",
        "@in-co-sandbox/rollup-config": "workspace:*",
        "@in-co-sandbox/typescript-config": "workspace:*",
        "@types/node": "catalog:",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:",
        "rollup": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/in-co-sandbox/sandbox-client-node.git",
        "directory": "packages/clients/kyc"
    },
    "publishConfig": {
        "access": "public"
    }
}

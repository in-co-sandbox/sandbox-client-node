{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "CreateSessionRequest",
    "type": "object",
    "properties": {
        "flow": {
            "type": "string",
            "enum": ["signin", "signup"],
            "description": "Indicates whether the user is signing in or signing up on DigiLocker"
        },
        "doc_types": {
            "type": "array",
            "description": "Documents you need consent for.",
            "items": {
                "type": "string",
                "enum": ["aadhaar", "driving_license", "pan"]
            }
        },
        "\"@entity\"": {
            "type": "string",
            "enum": ["in.co.sandbox.kyc.digilocker.sdk.session.request"]
        }
    },
    "required": ["@entity", "flow", "doc_types"]
}

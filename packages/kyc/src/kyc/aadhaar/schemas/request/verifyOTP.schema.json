{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "VerifyOtpRequest",
    "type": "object",
    "properties": {
        "reference_id": {
            "type": "string",
            "description": "Reference ID received in the Generate OTP response"
        },
        "otp": {
            "type": "string",
            "description": "OTP generated to mobile number associated with Aadhaar",
            "pattern": "[0-9]",
            "minLength": 6,
            "maxLength": 6
        },
        "\"@entity\"": {
            "type": "string",
            "const": "in.co.sandbox.kyc.aadhaar.okyc.request"
        }
    },
    "required": ["@entity", "reference_id", "otp"]
}

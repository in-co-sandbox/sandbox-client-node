{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "GenerateOtpRequest",
    "type": "object",
    "properties": {
        "aadhaar_number": {
            "type": "string",
            "description": "12-digit number issued by the UIDAI",
            "minLength": 12,
            "maxLength": 12,
            "pattern": "[0-9]"
        },
        "consent": {
            "type": "string",
            "enum": ["Y", "y"],
            "description": "Consent of the end-user to get their information for verification purposes."
        },
        "reason": {
            "type": "string",
            "description": "Indicate the purpose for verification."
        },
        "\"@entity\"": {
            "type": "string",
            "enum": ["in.co.sandbox.kyc.aadhaar.okyc.otp.request"]
        }
    },
    "required": ["@entity", "aadhaar_number", "consent", "reason"]
}

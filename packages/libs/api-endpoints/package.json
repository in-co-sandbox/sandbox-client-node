{
    "name": "@in-co-sandbox/api-endpoints",
    "version": "2.0.0",
    "type": "module",
    "description": "Base URLs of the Sandbox API",
    "homepage": "https://sandbox.co.in",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/in-co-sandbox/sandbox-client-node.git",
        "directory": "packages/libs/api-endpoints"
    },
    "license": "ISC",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist/**/*"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "clean": "sandbox-clean",
        "build": "sandbox-rollup lib",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix"
    },
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@in-co-sandbox/rollup-config": "workspace:*",
        "@in-co-sandbox/typescript-config": "workspace:*",
        "@in-co-sandbox/vitest-config": "workspace:*",
        "@types/node": "catalog:",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:",
        "rollup": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    }
}

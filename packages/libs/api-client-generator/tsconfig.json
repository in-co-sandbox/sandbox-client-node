{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"outDir": "./dist",
		"baseUrl": "./",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"declaration": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"noImplicitAny": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "generated"]
}

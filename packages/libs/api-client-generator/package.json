{
	"name": "@in-co-sandbox/api-client-generator",
	"version": "1.0.0",
	"type": "module",
	"description": "OpenAPI client SDK generator with runtime validation for in-co-sandbox API",
	"homepage": "https://sandbox.co.in",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/in-co-sandbox/sandbox-client-node.git",
		"directory": "packages/libs/api-client-generator"
	},
	"license": "ISC",
	"main": "dist/src/index.js",
	"bin": {
		"openapi-to-client": "dist/src/index.js"
	},
	"files": [
		"dist/**/*"
	],
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"clean": "sandbox-clean",
		"build": "sandbox-rollup lib && node --input-type=module -e \"import { cpSync } from 'node:fs'; cpSync('templates', 'dist/templates', { recursive: true });\"",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"change-case": "catalog:",
		"json-schema-faker": "catalog:",
		"json-schema-to-zod": "catalog:",
		"mustache": "catalog:"
	},
	"devDependencies": {
		"@in-co-sandbox/oxfmt-config": "workspace:*",
		"@types/mustache": "catalog:",
		"openapi-types": "catalog:",
		"@in-co-sandbox/rollup-config": "workspace:*",
		"@in-co-sandbox/typescript-config": "workspace:*",
		"@types/node": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"rollup": "catalog:",
		"typescript": "catalog:"
	}
}
